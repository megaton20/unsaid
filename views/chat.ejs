    /* TYPING INDICATOR - Positioned at bottom */
    #typing-indicator-container {
        width: 100%;
    }
    
    #typing-indicator {
        display: none;
        padding: 10px 15px;
        align-items: center;
        gap: 10px;
        background: rgba(17, 17, 17, 0.3);
        border-radius: 12px;
        margin: 5px 0;
